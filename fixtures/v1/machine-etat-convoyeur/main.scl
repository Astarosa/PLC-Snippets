// Surveillance : la pièce doit atteindre la sortie avant TempsMaxTransfert
#TempoTransfert(IN := (#Etape = #ST_TRANSFERT) AND NOT #CapteurSortie,
                PT := #TempsMaxTransfert);

CASE #Etape OF
    #ST_ATTENTE:
        #Moteur := FALSE;
        IF #Marche AND #Arret AND #CapteurEntree THEN
            #Etape := #ST_TRANSFERT;
        END_IF;

    #ST_TRANSFERT:
        #Moteur := TRUE;
        IF NOT #Arret OR #CapteurSortie THEN
            #Etape := #ST_ATTENTE;
        ELSIF #TempoTransfert.Q THEN
            #Etape := #ST_DEFAUT;
        END_IF;

    #ST_DEFAUT:
        #Moteur := FALSE;
        IF #Acquit THEN
            #Etape := #ST_ATTENTE;
        END_IF;

    ELSE
        #Etape := #ST_ATTENTE;
END_CASE;

#Defaut := (#Etape = #ST_DEFAUT);
