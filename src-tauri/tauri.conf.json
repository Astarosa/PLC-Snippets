{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLC Snippets",
  "version": "0.3.3",
  "identifier": "fr.baptiste.plcsnippets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PLC Snippets",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "shortDescription": "Bibliothèque de snippets automate"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5OTFCMjcyNjQ3NDdFMjMKUldRamZuUmtjcktSQ2FJWnlockV3Q3RuYVpDK2VWeDF4allIVDBOeDlxTnFKMHpFcFN4c2llbTkK",
      "endpoints": [
        "https://github.com/Astarosa/PLC-Snippets/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
